# 模型配置（复制为 .env 后填写，或用环境变量注入）
# 兼容任何 OpenAI 风格接口：DeepSeek / 火山方舟 / OpenAI / 本地 vLLM
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 服务
PORT=8787
HOST=127.0.0.1
# 答案校验（C1）
DUAL_SOLVE=1
MATH_PYTHON_PATH=../.tooling/py

# 模型自主调用工具（C2），需要模型支持 function calling
AGENT_MODE=0
AGENT_MAX_ROUNDS=6

# 第二模型（异构校验）：独立求解与裁决会走这个模型，能发现「同一模型稳定地错」
# 留空则自动回退主模型。任何 OpenAI 兼容服务都行（智谱 / 通义 / Kimi / OpenRouter / 本地 Ollama）
# LLM_VERIFY_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_VERIFY_API_KEY=
# LLM_VERIFY_MODEL=glm-4-flash

LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
CACHE_DIR=.cache/ai
