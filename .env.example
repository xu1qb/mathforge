# 模型配置（复制为 .env 后填写，或用环境变量注入）
# 兼容任何 OpenAI 风格接口：DeepSeek / 火山方舟 / OpenAI / 本地 vLLM
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 服务
PORT=8787
HOST=127.0.0.1
# 答案校验（C1）
DUAL_SOLVE=1
MATH_PYTHON_PATH=../.tooling/py

# 模型自主调用工具（C2），需要模型支持 function calling
AGENT_MODE=0
AGENT_MAX_ROUNDS=6

LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
CACHE_DIR=.cache/ai
