#!/usr/bin/env bash
# 提交前强制跑一遍检查；不通过就拦住提交。
# 紧急情况可以 git commit --no-verify 跳过，但请不要养成习惯。
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-commit: 正在跑 npm run check ..."
if ! npm run check; then
  echo
  echo "✗ 检查未通过，提交已阻止。修好后重新提交，或 git commit --no-verify 强制跳过。"
  exit 1
fi
echo "✓ pre-commit 通过"
